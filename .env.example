APP_ENV=development
APP_NAME=Keepit
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Password for keepit_app, the limited role the API/worker use (row-level security applies).
# scripts/init-local-security.py generates both passwords.
APP_DB_PASSWORD=
POSTGRES_DB=records

# Local (non-Docker) development connection. Docker builds its own URLs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/records
# Seed the admin + defaults on an empty database at container start (development).
AUTO_SEED=true

TIMEZONE=Asia/Yangon
FRONTEND_URL=http://localhost
API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org

WORKER_INTERVAL_SECONDS=300
WORKER_BATCH_SIZE=100
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_SECONDS=60

LOG_LEVEL=INFO
FRONTEND_PORT=80
# Optional read-only assistant (backend only; never expose these in VITE_* variables)
OPENAI_API_KEY=
OPENAI_MODEL=

# Local deployment. Production additionally requires HTTPS and strong DB/signing credentials.
DEPLOYMENT_ENV=development
DATA_ENCRYPTION_KEYS=
BACKUP_ENCRYPTION_KEY=
REQUIRE_ADMIN_MFA=false
BOOTSTRAP_ADMIN_PASSWORD=

# Documents (AssetWise): local volume by default, or any S3-compatible store
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI for the assistant and document extraction (OpenAI-compatible). Overridable in Asset Settings > AI.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Password-reset email via Resend (empty = reset links are written to the API log)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Passkeys: the site's registrable domain and the exact origins users open
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost

# MCP server (docker compose run --rm -T mcp). Create the token in Settings > Account.
MCP_API_TOKEN=
